# Ambiente: dev | test | prod
APP_ENV=dev
APP_PORT=4000
LOG_LEVEL=INFO

# Banco (docker compose)
DATABASE_URL=postgresql+asyncpg://reo:reo@localhost:5432/reo
TEST_DATABASE_URL=postgresql+asyncpg://reo:reo@localhost:5433/reo_test

# JWT — gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# A API recusa subir com "troque-isto" ou segredo com menos de 32 caracteres.
JWT_SECRET=troque-isto
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
INVITE_TOKEN_HOURS=72
# Base do link de convite gerado pela API (o site abre <base>/convite/<token>)
INVITE_BASE_URL=http://localhost:5173

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://mplihd.github.io,http://localhost:8081

# Admin criado pelo seed
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@reo.local
SEED_ADMIN_REGISTRATION=ADM-0001
SEED_ADMIN_PASSWORD=troque-isto
